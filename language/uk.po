msgid "Пока дети отдыхают, родители должны быть спокойны."
msgstr "Поки діти відпочивають, батьки мають бути спокійні."

msgid "КОМАНДА ВЗРОСЛЫХ"
msgstr "КОМАНДА ДОРОСЛИХ"

msgid "Дети находятся под присмотром команды лагеря."
msgstr "Діти перебувають під наглядом команди табору."

msgid "Медицинская страховка включена."
msgstr "Медичне страхування включено."

msgid "Организованное проживание группы."
